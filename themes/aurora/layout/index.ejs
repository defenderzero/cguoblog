<div class="layout">
  <div class="content-col">
    <div class="section-head">
      <div>
        <h1 class="section-title">最新文章</h1>
        <p class="section-desc">记录技术、生活与那些值得留下来的想法。</p>
      </div>
      <span class="section-sub">共 <%= site.posts.length %> 篇</span>
    </div>

    <div class="post-grid">
      <%
      var cardIndex = 0;
      page.posts.each(function (post) {
      %>
        <%- partial('_partial/post-card', { post: post, featured: cardIndex === 0 }) %>
      <%
        cardIndex++;
      });
      %>
    </div>

    <%- partial('_partial/pagination') %>
  </div>

  <aside class="sidebar">
    <%- partial('_partial/sidebar') %>
  </aside>
</div>
