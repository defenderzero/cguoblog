<%
function navActive(target) {
  if (target === '/') return is_home();
  var current = (page.path || '').replace(/index\.html$/, '');
  return current.indexOf(target.replace(/^\//, '')) === 0;
}
%>
<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页">
      <span class="brand-mark"><%= theme.brand_mark || '博' %></span>
      <span class="brand-name"><%= config.title %></span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      <% (theme.menu || []).forEach(function (item) { %>
        <a href="<%- url_for(item.url) %>" class="<%= navActive(item.url) ? 'active' : '' %>"><%= item.name %></a>
      <% }); %>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" id="searchOpen" type="button" aria-label="搜索">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
      </button>
      <button class="icon-btn theme-toggle" id="themeToggle" type="button" aria-label="切换深色模式">
        <svg class="icon-moon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8Z"></path></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button class="icon-btn menu-toggle" id="menuToggle" type="button" aria-label="打开菜单">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobileNav" aria-label="移动端导航">
    <% (theme.menu || []).forEach(function (item) { %>
      <a href="<%- url_for(item.url) %>"><%= item.name %></a>
    <% }); %>
  </nav>
</header>

<div class="search-overlay" id="searchOverlay">
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search-bar">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
      <input type="search" id="searchInput" placeholder="搜索文章标题或内容…" autocomplete="off">
      <button type="button" id="searchClose" class="search-close">ESC</button>
    </div>
    <div class="search-results" id="searchResults">
      <p class="search-hint">输入关键词，搜索全站文章</p>
    </div>
    <div class="search-footer">按 <kbd>/</kbd> 快速打开搜索，<kbd>Esc</kbd> 关闭</div>
  </div>
</div>
