<% if (page.total > 1) { %>
<nav class="pagination" aria-label="分页">
  <% if (page.prev_link) { %>
    <a class="page-btn" href="<%- url_for(page.prev_link) %>">← 上一页</a>
  <% } else { %>
    <span class="page-btn is-disabled">← 上一页</span>
  <% } %>
  <span class="page-info"><%= page.current %> / <%= page.total %></span>
  <% if (page.next_link) { %>
    <a class="page-btn" href="<%- url_for(page.next_link) %>">下一页 →</a>
  <% } else { %>
    <span class="page-btn is-disabled">下一页 →</span>
  <% } %>
</nav>
<% } %>
