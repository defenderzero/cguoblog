<nav class="breadcrumb" aria-label="面包屑">
  <a href="<%- url_for('/') %>">首页</a>
  <span class="sep">/</span>
  <span class="current"><%= page.title %></span>
</nav>

<div class="layout">
  <div class="content-col">
    <article class="card article-card page-article">
      <header class="post-header">
        <h1 class="post-title"><%= page.title %></h1>
        <% if (page.description) { %><p class="page-desc"><%= page.description %></p><% } %>
      </header>
      <div class="post-content">
        <%- page.content %>
      </div>
    </article>
  </div>

  <aside class="sidebar">
    <%- partial('_partial/sidebar') %>
  </aside>
</div>
